# Rating Watch billing configuration. Names only: copy to .env.local (never commit values).
# Full walkthrough: docs/billing/SETUP.md
# NEXT_PUBLIC_* variables are inlined at BUILD time (in Coolify mark them as Build Variables).
# Everything else is read at RUNTIME and may be a normal Coolify environment variable.

# --- Paywall stays off until configured ---
# AR mode (/camera-vision/ar) is FREE until ALL six of these are set, so deploying before configuring is safe:
#   1. GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
#   2. JWT_SECRET (32+ characters)
#   3. PADDLE_API_KEY
#   4. PADDLE_WEBHOOK_SECRET
#   5. PADDLE_PRICE_IDS (or NEXT_PUBLIC_PADDLE_PRICE_ID_MONTHLY and NEXT_PUBLIC_PADDLE_PRICE_ID_YEARLY)
#   6. NEXT_PUBLIC_PADDLE_CLIENT_TOKEN (a NEXT_PUBLIC_* value: in Coolify mark it as a BUILD variable; needs a rebuild)
# Once all six are set the paywall turns on by itself. Verify: GET /api/user/me returns "billingEnabled":true.

# --- Paddle, browser side (build time) ---
# "sandbox" or "production". Unset means sandbox. Production must be set before building for the live site.
NEXT_PUBLIC_PADDLE_ENV=
# Paddle Dashboard > Developer Tools > Authentication > Client-side tokens (test_ or live_ prefix, safe for the browser).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Paddle Dashboard > Catalog > Prices. Monthly price id (starts with pri_).
NEXT_PUBLIC_PADDLE_PRICE_ID_MONTHLY=
# Paddle Dashboard > Catalog > Prices. Yearly price id (starts with pri_).
NEXT_PUBLIC_PADDLE_PRICE_ID_YEARLY=

# --- Paddle, server side (runtime, secret) ---
# Paddle Dashboard > Developer Tools > Authentication > API keys. Needs read access to subscriptions/transactions and write access to customer portal sessions.
PADDLE_API_KEY=
# Paddle Dashboard > Developer Tools > Notifications > your webhook destination > Secret key.
PADDLE_WEBHOOK_SECRET=
# "sandbox" or "production" for server API calls. Optional: falls back to NEXT_PUBLIC_PADDLE_ENV, then sandbox.
PADDLE_ENV=
# The Rating Watch price ids, comma-separated (for example the monthly and yearly pri_ ids). Runtime variable.
# REQUIRED in production because the Paddle account is shared: webhook events and checkout verification for any
# other price are ignored. If unset, the two NEXT_PUBLIC_PADDLE_PRICE_ID_* values are used; if those are unset
# too, no subscription can activate (fails closed).
PADDLE_PRICE_IDS=

# --- Google sign-in (runtime) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application).
GOOGLE_CLIENT_ID=
# Same OAuth client. Secret.
GOOGLE_CLIENT_SECRET=

# --- Sessions and storage (runtime) ---
# Random string of 32+ characters used to sign session cookies. Generate with: openssl rand -hex 32. Secret.
JWT_SECRET=
# Public origin used to build OAuth redirects. Defaults to https://rating.watch, so set it in local dev (for example http://localhost:3000).
APP_URL=
# Directory for the SQLite users database (users.db). Leave unset: it defaults to .data, which on Coolify is
# /app/.data, the recommended persistent volume mount (it also holds the ratings cache, .data/ratings.json).
DATA_DIR=
# Optional full path to the users database file. Overrides DATA_DIR/users.db. Leave unset in production;
# scripts/dev-seed-user.mjs uses it for throwaway local databases.
USERS_DB_PATH=
